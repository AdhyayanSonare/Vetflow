{
  "name": "vetflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Vetflow: clinical records, prescriptions and medicine inventory for veterinary hospital groups.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "demo:reset": "tsx scripts/demo.ts --reset",
    "dev": "tsx watch server/index.ts",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsx scripts/build-server.ts",
    "start": "node dist/index.js",
    "worker": "tsx server/jobs/worker.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:baseline": "tsx scripts/db-baseline.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset-demo": "tsx scripts/db-reset-demo.ts",
    "db:reload-demo": "tsx scripts/db-reload-demo.ts",
    "db:check": "tsx scripts/db-check.ts",
    "tenant:create": "tsx scripts/tenant-create.ts",
    "user:set-password": "tsx scripts/user-set-password.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:fast": "vitest run -c vitest.fast.config.ts",
    "perf": "tsx scripts/perf.ts",
    "eval:asr": "tsx eval/asr/run.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint .",
    "licences": "tsx scripts/check-licences.ts",
    "secrets": "tsx scripts/scan-secrets.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "i18next": "^25.10.10",
    "lucide-react": "^0.453.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^16.6.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "4.17.21",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "^0.25.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "unzipper": "^0.12.5"
    }
  }
}
