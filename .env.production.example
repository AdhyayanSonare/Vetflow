# Copy to .env on the server. Never commit the real file. See docs/runbooks/deploy.md.

# The public address. A domain name gives automatic HTTPS. ":80" serves plain HTTP (for testing).
SITE_ADDRESS=vetflow.example.com

# Use long random values with letters and numbers only (they go into connection URLs).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Optional shared password in front of the whole site, for a public demo.
SITE_PASSWORD=

# Hosted speech to text and note drafting (Groq). Leave blank to run without them.
GROQ_API_KEY=
# Local speech service, when started with: docker compose --profile asr up -d
ASR_URL=
ASR_PROVIDER=whisper

# Off-site encrypted backups (restic). Example: s3:s3.amazonaws.com/your-bucket/vetflow
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=30
# Called with a POST when a backup fails (for example an Uptime Kuma push URL or a chat webhook).
ALERT_WEBHOOK_URL=

LOG_LEVEL=info
