# Copy to .env (gitignored) and fill in. Never commit real values.

# Application connection. Must be the non-superuser role vetflow_app so row-level security applies.
# Supabase (Tokyo, ap-northeast-1), session pooler works over IPv4:
#   postgresql://vetflow_app.gcqzqygizhcjygubiisl:<APP_DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Docker Compose: postgresql://vetflow_app:<APP_DB_PASSWORD>@postgres:5432/vetflow
DATABASE_URL=

# Owner connection, used only by `pnpm db:migrate` and seeding. Supabase: the postgres role.
#   postgresql://postgres.gcqzqygizhcjygubiisl:<POSTGRES_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
ADMIN_DATABASE_URL=

# Password to set on the vetflow_app role during migration.
APP_DB_PASSWORD=

SESSION_SECRET=
PORT=3000
